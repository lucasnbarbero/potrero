# Conexión de la aplicación: rol sin privilegios, sujeto a Row Level Security.
DATABASE_URL=postgresql://potrero_app:potrero_app@localhost:55432/potrero
# Conexión de administración: migraciones, semillas y tareas de sistema (webhooks, sitio público).
DATABASE_URL_ADMIN=postgresql://potrero_admin:potrero_admin@localhost:55432/potrero
DATABASE_URL_SHADOW=postgresql://potrero_admin:potrero_admin@localhost:55432/potrero_shadow
# Secreto para firmar los tokens de acceso (mínimo 32 caracteres). Cambiar en cada entorno.
JWT_SECRET=cambiar-este-secreto-de-desarrollo-por-uno-largo
PORT=4000
# URL pública de la web (links de pago e inscripción).
WEB_URL=http://localhost:3000
# Pasarela de pagos: "simulada" (desarrollo y demo) o "mercadopago" (requiere credenciales).
PASARELA_PAGOS=simulada
# Canales de mensajería: "simulada" (no sale nada a nadie) o "real" (requiere BSP de WhatsApp y proveedor de email).
MENSAJERIA=simulada
# Entorno de demo pública (ADR-019): "true" solo en el despliegue de la demo. Exige PASARELA_PAGOS=simulada.
DEMO_MODE=false
# Límites de la demo: sandboxes activas en total y creadas por IP por hora.
DEMO_MAX_SANDBOXES=200
DEMO_MAX_POR_IP_HORA=5
# Clave secreta de Cloudflare Turnstile. Si se define, crear una sandbox exige el captcha resuelto.
# TURNSTILE_SECRET=
# Proxies delante de la API (el servidor de Next cuenta como 1) para leer la IP real del visitante.
PROXIES_CONFIABLES=0
# Secreto para firmar las notificaciones simuladas de pago.
WEBHOOK_SECRET=cambiar-este-secreto-de-webhook
