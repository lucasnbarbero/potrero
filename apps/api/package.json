{
  "name": "@potrero/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsc -p tsconfig.build.json && node scripts/test-db.mjs && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:seed": "tsc -p tsconfig.build.json && node dist/seed/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@potrero/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "jose": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@potrero/config": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "pg": "^8.16.0",
    "@types/pg": "^8.15.0"
  }
}
