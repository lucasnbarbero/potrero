// Modelo de datos de Potrero. Referencia funcional: documento 1, sección 4.
// Convención: nombres de dominio en español; tablas en snake_case.
// Toda tabla de una organización lleva `organizacionId` y está protegida con Row Level Security
// (ver la migración `rls`). Las tablas globales (usuarios, organizaciones, membresías, sesiones, auditoría) no.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identidad y organizaciones (globales) ─────────────

model Usuario {
  id                String          @id @default(cuid())
  email             String          @unique
  nombre            String
  passwordHash      String          @map("password_hash")
  creadoEn          DateTime        @default(now()) @map("creado_en")
  membresias        Membresia[]
  sesiones          SesionRefresh[]
  // Cuenta (E04-02): email verificado y links de un solo uso (recuperación y verificación).
  emailVerificadoEn DateTime?       @map("email_verificado_en")
  linksCuenta       LinkCuenta[]

  @@map("usuario")
}

/// Plan de suscripción mensual (cuota, límites y módulos en docs/datos.json).
enum Plan {
  TORNEO
  LIGA
  PRO
}

model Organizacion {
  id                   String      @id @default(cuid())
  nombre               String
  slug                 String      @unique
  plan                 Plan        @default(LIGA)
  /// Liga fundadora: 50 % de descuento de por vida en su plan (no es un plan aparte).
  fundadora            Boolean     @default(false)
  /// El organizador absorbe el cargo por servicio de los pagos online (por defecto lo paga el equipo).
  absorbeCargoServicio Boolean     @default(false) @map("absorbe_cargo_servicio")
  colorMarca           String?     @map("color_marca")
  /// Cuenta de Mercado Pago conectada por OAuth. En modo simulado, un identificador ficticio.
  mpCuentaId           String?     @map("mp_cuenta_id")
  creadoEn             DateTime    @default(now()) @map("creado_en")
  /// Solo en el entorno de demo (ADR-019): las sandboxes de visitantes vencen y un job las elimina. Nulo en una liga real.
  demoExpiraEn         DateTime?   @map("demo_expira_en")
  membresias           Membresia[]
  /// Configuración inicial (E25): logo (data URL), localidad, provincia y los pasos confirmados del asistente.
  logo                 String?
  localidad            String?
  provincia            String?
  configuracionInicial Json?       @map("configuracion_inicial")

  @@index([demoExpiraEn])
  @@map("organizacion")
}

enum Rol {
  DUENO
  ADMINISTRADOR
  TESORERO
  ARBITRO
  TRIBUNAL
  /// Capitán de un equipo (E19): solo ve y opera su equipo (`Membresia.equipoId`).
  CAPITAN
  /// Jugador con cuenta (E20-01): solo ve lo suyo (`Membresia.jugadorId`).
  JUGADOR
}

model Membresia {
  id             String       @id @default(cuid())
  usuarioId      String       @map("usuario_id")
  organizacionId String       @map("organizacion_id")
  rol            Rol
  creadoEn       DateTime     @default(now()) @map("creado_en")
  /// Alcance del rol CAPITAN: el equipo que maneja. Nulo en los demás roles.
  equipoId       String?      @map("equipo_id")
  /// Alcance del rol JUGADOR (E20-01): el perfil de jugador que reclamó. Nulo en los demás roles.
  jugadorId      String?      @map("jugador_id")
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, organizacionId])
  @@unique([organizacionId, jugadorId])
  @@map("membresia")
}

/// Token de renovación. Se guarda solo el hash; cada uso lo rota. Si se reutiliza uno ya rotado, se revoca la familia.
model SesionRefresh {
  id                   String    @id @default(cuid())
  usuarioId            String    @map("usuario_id")
  familia              String
  tokenHash            String    @unique @map("token_hash")
  expiraEn             DateTime  @map("expira_en")
  revocadoEn           DateTime? @map("revocado_en")
  creadoEn             DateTime  @default(now()) @map("creado_en")
  usuario              Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Organización activa de la sesión (E04-10): la renovación la mantiene. Nula = la primera membresía.
  organizacionActivaId String?   @map("organizacion_activa_id")

  @@index([familia])
  @@map("sesion_refresh")
}

/// Registro inmutable de acciones sensibles.
model Auditoria {
  id             String   @id @default(cuid())
  organizacionId String?  @map("organizacion_id")
  usuarioId      String?  @map("usuario_id")
  accion         String
  entidad        String
  entidadId      String   @map("entidad_id")
  antes          Json?
  despues        Json?
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([organizacionId, creadoEn])
  @@map("auditoria")
}

// ── Cuenta del usuario (E04-02, E04-05) ──

enum TipoLinkCuenta {
  RECUPERAR
  VERIFICAR_EMAIL
}

/// Link de un solo uso que se manda por email (recuperar la contraseña, verificar el email). Se guarda solo el hash.
model LinkCuenta {
  id        String         @id @default(cuid())
  usuarioId String         @map("usuario_id")
  tipo      TipoLinkCuenta
  tokenHash String         @unique @map("token_hash")
  /// Email al que se mandó: verificar un email viejo no marca como verificado el nuevo.
  email     String
  venceEn   DateTime       @map("vence_en")
  usadoEn   DateTime?      @map("usado_en")
  creadoEn  DateTime       @default(now()) @map("creado_en")
  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@map("link_cuenta")
}

/// Intento de ingreso (E04-05): limita la fuerza bruta por cuenta y por IP.
model IntentoIngreso {
  id       String   @id @default(cuid())
  email    String
  ip       String
  exitoso  Boolean
  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([email, creadoEn])
  @@index([ip, creadoEn])
  @@map("intento_ingreso")
}

// ───────────── Torneos (por organización, con RLS) ─────────────

enum Modalidad {
  F5
  F7
  F8
  F11
}

enum Formato {
  LIGA
  COPA
  GRUPOS_PLAYOFFS
  LIGA_PLAYOFFS
  /// Por fases, armado en "Armá el formato" (ADR-026). Las fases están en `Fase`.
  FLEXIBLE
}

enum EstadoTorneo {
  BORRADOR
  INSCRIPCION
  EN_CURSO
  FINALIZADO
}

/// Reglamento versionado: el torneo fija una versión y los cambios crean una nueva.
model Reglamento {
  id                      String   @id @default(cuid())
  organizacionId          String   @map("organizacion_id")
  nombre                  String
  version                 Int      @default(1)
  puntosVictoria          Int      @map("puntos_victoria")
  puntosEmpate            Int      @map("puntos_empate")
  puntosDerrota           Int      @map("puntos_derrota")
  desempates              String[]
  suspensionRojaDirecta   Int      @map("suspension_roja_directa")
  suspensionDobleAmarilla Int      @map("suspension_doble_amarilla")
  umbralAmarillas         Int      @map("umbral_amarillas")
  suspensionAcumulacion   Int      @map("suspension_acumulacion")
  golesWO                 Int      @map("goles_wo")
  /// Levantar una suspensión pagando (E14-08): opcional, qué tipos y cuánto por partido (pesos; 0 = no disponible).
  levantarSancionPagando  Boolean  @default(false) @map("levantar_sancion_pagando")
  levantarSancionTipos    String[] @default(["ACUMULACION", "DOBLE_AMARILLA"]) @map("levantar_sancion_tipos")
  levantarSancionMonto    Int      @default(0) @map("levantar_sancion_monto")
  /// Equipo ausente (F11): minutos de tolerancia desde la hora del partido antes de poder marcarlo.
  toleranciaWOMinutos     Int      @default(15) @map("tolerancia_wo_minutos")
  creadoEn                DateTime @default(now()) @map("creado_en")
  torneos                 Torneo[]

  @@map("reglamento")
}

model Torneo {
  id                   String        @id @default(cuid())
  organizacionId       String        @map("organizacion_id")
  nombre               String
  slug                 String
  modalidad            Modalidad
  formato              Formato
  idaYVuelta           Boolean       @default(false) @map("ida_y_vuelta")
  estado               EstadoTorneo  @default(BORRADOR)
  cupo                 Int
  /// Arancel de inscripción por equipo, en pesos.
  inscripcion          Int
  reglamentoId         String        @map("reglamento_id")
  creadoEn             DateTime      @default(now()) @map("creado_en")
  /// Fecha límite para pagar la inscripción. Los cargos nuevos la heredan.
  venceInscripcion     DateTime?     @map("vence_inscripcion") @db.Date
  /// Cuadro de playoffs: lugares en orden (null = pase libre) y la programación de las rondas. Ver apps/api/src/torneos/llaves.ts.
  llave                Json?
  /// Grupos de la fase de grupos: [{ grupo, equipoIds }].
  grupos               Json?
  /// Documentos que exige el torneo a sus jugadores (ver TIPOS_DOCUMENTO). Vacío = no exige.
  documentosRequeridos String[]      @default([]) @map("documentos_requeridos")
  /// Cuota por fecha y seguro por jugador (E06-20/21): ConfigCobrosPorFecha de @potrero/shared. Nulo = valores por defecto.
  cobrosPorFecha       Json?         @map("cobros_por_fecha")
  reglamento           Reglamento    @relation(fields: [reglamentoId], references: [id])
  inscripciones        Inscripcion[]
  partidos             Partido[]
  sanciones            Sancion[]
  expedientes          Expediente[]
  /// Torneos por fases (ADR-026): una fila por fase del formato.
  fases                Fase[]

  @@unique([organizacionId, slug])
  @@map("torneo")
}

/// Equipo a nivel organización: se reutiliza entre torneos.
model Equipo {
  id                   String           @id @default(cuid())
  organizacionId       String           @map("organizacion_id")
  nombre               String
  color                String?
  capitanNombre        String?          @map("capitan_nombre")
  capitanEmail         String?          @map("capitan_email")
  capitanTelefono      String?          @map("capitan_telefono")
  /// Aceptó recibir WhatsApp. Sin esto no se le escribe por ahí (E16-05).
  capitanOptInWhatsapp Boolean          @default(false) @map("capitan_optin_whatsapp")
  /// Pidió no recibir novedades: frena solo los mensajes de marketing.
  capitanBajaMarketing Boolean          @default(false) @map("capitan_baja_marketing")
  creadoEn             DateTime         @default(now()) @map("creado_en")
  plantel              PlantelJugador[]
  inscripciones        Inscripcion[]

  @@unique([organizacionId, nombre])
  @@map("equipo")
}

/// Jugador con identidad única dentro de la organización (base de duplicados y trayectoria).
model Jugador {
  id                  String             @id @default(cuid())
  organizacionId      String             @map("organizacion_id")
  nombre              String
  apellido            String
  creadoEn            DateTime           @default(now()) @map("creado_en")
  fechaNacimiento     DateTime?          @map("fecha_nacimiento") @db.Date
  /// DNI y datos de salud cifrados a nivel de campo (AES-256-GCM, ver comun/cifrado.ts). El hash permite buscar duplicados.
  dniCifrado          String?            @map("dni_cifrado")
  dniHash             String?            @map("dni_hash")
  datosMedicosCifrado String?            @map("datos_medicos_cifrado")
  /// Sitio público (E20-04): apodo y cómo se lo nombra (INICIALES, APODO o COMPLETO; ver jugadorPublico en @potrero/shared).
  apodo               String?
  nombrePublico       String             @default("INICIALES") @map("nombre_publico")
  plantel             PlantelJugador[]
  documentos          DocumentoJugador[]
  consentimientos     Consentimiento[]

  @@index([organizacionId, dniHash])
  @@map("jugador")
}

model PlantelJugador {
  id             String  @id @default(cuid())
  organizacionId String  @map("organizacion_id")
  equipoId       String  @map("equipo_id")
  jugadorId      String  @map("jugador_id")
  numero         Int?
  equipo         Equipo  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  jugador        Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)

  @@unique([equipoId, jugadorId])
  @@map("plantel_jugador")
}

// ───────────── Inscripciones y cobros ─────────────

enum EstadoInscripcion {
  PENDIENTE
  CONFIRMADA
  BAJA
}

model Inscripcion {
  id             String            @id @default(cuid())
  organizacionId String            @map("organizacion_id")
  torneoId       String            @map("torneo_id")
  equipoId       String            @map("equipo_id")
  estado         EstadoInscripcion @default(PENDIENTE)
  creadoEn       DateTime          @default(now()) @map("creado_en")
  torneo         Torneo            @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  equipo         Equipo            @relation(fields: [equipoId], references: [id])
  cargos         Cargo[]

  @@unique([torneoId, equipoId])
  @@map("inscripcion")
}

enum EstadoCargo {
  PENDIENTE
  PAGADO
  ANULADO
}

/// Lo que un equipo debe pagar (inscripción, seña, cuota por fecha, multa).
model Cargo {
  id             String      @id @default(cuid())
  organizacionId String      @map("organizacion_id")
  inscripcionId  String      @map("inscripcion_id")
  concepto       String
  monto          Int
  estado         EstadoCargo @default(PENDIENTE)
  /// De qué rubro de ingresos es (INSCRIPCIONES, MULTAS o SEGUROS): decide dónde entra en la caja.
  categoria      String      @default("INSCRIPCIONES")
  /// Vencimiento: de acá salen los recordatorios de cobro escalonados.
  vence          DateTime?   @db.Date
  creadoEn       DateTime    @default(now()) @map("creado_en")
  inscripcion    Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  pagos          Pago[]
  /// Cuota por fecha y seguro (E06-20/21): número de fecha y partido que lo originan. Nulos en los demás cargos.
  fecha          Int?
  partidoId      String?     @map("partido_id")
  /// Hace idempotente un cargo automático (por ejemplo, "cuota:<torneo>:<equipo>:<fecha>"): no se genera dos veces.
  clave          String?

  @@unique([organizacionId, clave])
  @@map("cargo")
}

enum MetodoPago {
  MERCADO_PAGO
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  /// Pago manual mal cargado y anulado: su cobro en la caja se revierte con otro asiento.
  ANULADO
}

model Pago {
  id               String     @id @default(cuid())
  organizacionId   String     @map("organizacion_id")
  cargoId          String     @map("cargo_id")
  metodo           MetodoPago
  monto            Int
  /// Cargo por servicio de Gregal (ingreso de Gregal, no del organizador). Cero en pagos manuales.
  cargoServicio    Int        @default(0) @map("cargo_servicio")
  /// Lo que retuvo Mercado Pago por el cobro.
  costoMercadoPago Int        @default(0) @map("costo_mercado_pago")
  /// El organizador absorbió el cargo: se descontó de lo que recibió.
  cargoAbsorbido   Boolean    @default(false) @map("cargo_absorbido")
  estado           EstadoPago @default(PENDIENTE)
  /// Preferencia de la pasarela (link de pago).
  preferenciaId    String?    @unique @map("preferencia_id")
  /// Identificador del pago en la pasarela: da idempotencia a las notificaciones.
  pasarelaPagoId   String?    @unique @map("pasarela_pago_id")
  comprobante      String?
  registradoPorId  String?    @map("registrado_por_id")
  creadoEn         DateTime   @default(now()) @map("creado_en")
  acreditadoEn     DateTime?  @map("acreditado_en")
  cargo            Cargo      @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  @@map("pago")
}

// ───────────── Canchas, fixture y partidos ─────────────

model Sede {
  id             String   @id @default(cuid())
  organizacionId String   @map("organizacion_id")
  nombre         String
  direccion      String?
  canchas        Cancha[]

  @@map("sede")
}

model Cancha {
  id              String    @id @default(cuid())
  organizacionId  String    @map("organizacion_id")
  sedeId          String    @map("sede_id")
  nombre          String
  /// Lo que cuesta alquilarla por partido, en pesos. Con la automatización encendida, al cerrar el acta va a la caja.
  costoPorPartido Int       @default(0) @map("costo_por_partido")
  superficie      String?
  /// Bloqueada (mantenimiento, clima): no se ofrece para armar fixtures.
  bloqueada       Boolean   @default(false)
  motivoBloqueo   String?   @map("motivo_bloqueo")
  sede            Sede      @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  partidos        Partido[]

  @@map("cancha")
}

/// Fase a la que pertenece un partido: liga, grupos o llave (eliminación directa).
enum FasePartido {
  LIGA
  GRUPOS
  LLAVE
}

enum EstadoPartido {
  PROGRAMADO
  EN_JUEGO
  FINALIZADO
  SUSPENDIDO
  WO
}

model Partido {
  id               String          @id @default(cuid())
  organizacionId   String          @map("organizacion_id")
  torneoId         String          @map("torneo_id")
  fecha            Int
  localId          String          @map("local_id")
  visitanteId      String          @map("visitante_id")
  canchaId         String?         @map("cancha_id")
  inicio           DateTime?
  estado           EstadoPartido   @default(PROGRAMADO)
  /// Resultado guardado al cerrar el acta (se deriva de los eventos).
  golesLocal       Int?            @map("goles_local")
  golesVisitante   Int?            @map("goles_visitante")
  ganadorWOId      String?         @map("ganador_wo_id")
  cerradoEn        DateTime?       @map("cerrado_en")
  fase             FasePartido     @default(LIGA)
  /// Letra del grupo (fase de grupos).
  grupo            String?
  /// Identificador del cruce dentro de la llave (ronda-posición). Nulo fuera de la fase de llave.
  clave            String?
  /// Definición por penales de un cruce de llave que terminó empatado.
  penalesLocal     Int?            @map("penales_local")
  penalesVisitante Int?            @map("penales_visitante")
  /// Árbitro designado y si ya confirmó (PENDIENTE o CONFIRMADO).
  arbitroId        String?         @map("arbitro_id")
  arbitroEstado    String?         @map("arbitro_estado")
  arbitro          Arbitro?        @relation(fields: [arbitroId], references: [id], onDelete: SetNull)
  /// Dispositivo que lleva el acta (un solo dueño por partido) y quién lo tomó.
  actaDispositivo  String?         @map("acta_dispositivo")
  actaUsuarioId    String?         @map("acta_usuario_id")
  actaTomadaEn     DateTime?       @map("acta_tomada_en")
  torneo           Torneo          @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  cancha           Cancha?         @relation(fields: [canchaId], references: [id])
  eventos          EventoPartido[]
  /// Torneos por fases (ADR-026): fase del partido, ronda de la llave y pierna (1 = ida o partido único, 2 = vuelta).
  faseId           String?         @map("fase_id")
  ronda            Int?
  pierna           Int?

  @@unique([torneoId, clave])
  @@index([torneoId, fecha])
  @@index([faseId])
  @@map("partido")
}

enum TipoEvento {
  GOL
  GOL_EN_CONTRA
  AMARILLA
  ROJA
  CAMBIO
  ANULACION
}

/// Evento del acta. Solo se agrega: las correcciones son eventos ANULACION.
model EventoPartido {
  id             String     @id @default(cuid())
  organizacionId String     @map("organizacion_id")
  partidoId      String     @map("partido_id")
  tipo           TipoEvento
  equipoId       String     @map("equipo_id")
  jugadorId      String?    @map("jugador_id")
  minuto         Int?
  anulaA         String?    @map("anula_a")
  /// Generado en el dispositivo: si llega dos veces, se ignora (base del acta offline).
  clientUuid     String     @unique @map("client_uuid")
  cargadoPorId   String?    @map("cargado_por_id")
  creadoEn       DateTime   @default(now()) @map("creado_en")
  partido        Partido    @relation(fields: [partidoId], references: [id], onDelete: Cascade)

  @@index([partidoId])
  @@map("evento_partido")
}

// ───────────── Disciplina ─────────────

enum CausaSancion {
  ROJA_DIRECTA
  DOBLE_AMARILLA
  ACUMULACION
  /// La impone el tribunal desde un expediente.
  TRIBUNAL
}

model Sancion {
  id              String                 @id @default(cuid())
  organizacionId  String                 @map("organizacion_id")
  torneoId        String                 @map("torneo_id")
  jugadorId       String                 @map("jugador_id")
  equipoId        String                 @map("equipo_id")
  partidoOrigenId String                 @map("partido_origen_id")
  causa           CausaSancion
  partidos        Int
  creadoEn        DateTime               @default(now()) @map("creado_en")
  torneo          Torneo                 @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  levantamientos  LevantamientoSancion[]

  @@unique([partidoOrigenId, jugadorId, causa])
  @@map("sancion")
}

/// Pedido de levantar un partido de suspensión pagando (E14-08). Es un cargo al equipo en el rubro MULTAS: levanta el
/// partido recién cuando el cargo queda PAGADO (pago acreditado). Si el cargo o el pedido se anulan, no levanta nada.
model LevantamientoSancion {
  id              String    @id @default(cuid())
  organizacionId  String    @map("organizacion_id")
  sancionId       String    @map("sancion_id")
  cargoId         String    @unique @map("cargo_id")
  monto           Int
  solicitadoPorId String?   @map("solicitado_por_id")
  anuladoEn       DateTime? @map("anulado_en")
  creadoEn        DateTime  @default(now()) @map("creado_en")
  sancion         Sancion   @relation(fields: [sancionId], references: [id], onDelete: Cascade)

  @@index([sancionId])
  @@map("levantamiento_sancion")
}

enum TipoExpediente {
  ROJA_DIRECTA
  AGRESION
  INCIDENTE_HINCHADA
  JUGADOR_NO_HABILITADO
  OTRO
}

enum EstadoExpediente {
  ABIERTO
  RESUELTO
}

/// Caso que revisa el tribunal: informe del árbitro, descargo del capitán y resolución (puede ampliar o reducir lo sugerido).
model Expediente {
  id                String           @id @default(cuid())
  organizacionId    String           @map("organizacion_id")
  torneoId          String           @map("torneo_id")
  partidoId         String?          @map("partido_id")
  equipoId          String           @map("equipo_id")
  jugadorId         String?          @map("jugador_id")
  tipo              TipoExpediente
  motivo            String
  informeArbitro    String?          @map("informe_arbitro")
  descargo          String?
  descargoEn        DateTime?        @map("descargo_en")
  /// Partidos que sugiere el reglamento (la sanción automática, si la hay).
  sugeridos         Int              @default(0)
  /// Sanción automática que este expediente revisa; al resolver se la modifica.
  sancionId         String?          @map("sancion_id")
  estado            EstadoExpediente @default(ABIERTO)
  /// Una sola vez por partido y jugador cuando lo abre el sistema (jugador no habilitado).
  clave             String?
  partidosResueltos Int?             @map("partidos_resueltos")
  multa             Int              @default(0)
  cargoId           String?          @map("cargo_id")
  veredicto         String?
  resolucion        String?
  resueltoPorId     String?          @map("resuelto_por_id")
  resueltoEn        DateTime?        @map("resuelto_en")
  creadoEn          DateTime         @default(now()) @map("creado_en")
  torneo            Torneo           @relation(fields: [torneoId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, clave])
  @@index([torneoId, estado])
  @@map("expediente")
}

// ───────────── Comunicación (por organización, con RLS) ─────────────

enum CanalMensaje {
  EMAIL
  WHATSAPP
  PUSH
}

enum EstadoMensaje {
  PENDIENTE
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

enum EstadoDifusion {
  PROGRAMADA
  ENVIADA
}

/// Un envío masivo: a quién, con qué plantilla y por qué canal se pidió.
model Difusion {
  id             String         @id @default(cuid())
  organizacionId String         @map("organizacion_id")
  plantilla      String
  canal          CanalMensaje
  titulo         String
  /// A quién va: { tipo: 'TODOS' | 'TORNEO' | 'MOROSOS' | 'EQUIPOS', ... }.
  segmento       Json
  /// Texto del mensaje libre (las demás plantillas ya tienen el suyo).
  texto          String?
  programadaPara DateTime?      @map("programada_para")
  estado         EstadoDifusion @default(ENVIADA)
  creadaPorId    String?        @map("creada_por_id")
  creadoEn       DateTime       @default(now()) @map("creado_en")
  mensajes       Mensaje[]

  @@index([organizacionId, creadoEn])
  @@map("difusion")
}

/// Un mensaje a una persona. Es el historial de lo enviado, con su costo y su estado de entrega.
model Mensaje {
  id             String        @id @default(cuid())
  organizacionId String        @map("organizacion_id")
  difusionId     String?       @map("difusion_id")
  contingenciaId String?       @map("contingencia_id")
  equipoId       String?       @map("equipo_id")
  /// Hace idempotente un envío automático (por ejemplo, "rec24:partido:equipo"): no se manda dos veces.
  clave          String?
  plantilla      String
  version        Int
  canal          CanalMensaje
  destinatario   String
  destino        String
  asunto         String
  cuerpo         String
  estado         EstadoMensaje @default(PENDIENTE)
  costoUsd       Float         @default(0) @map("costo_usd")
  proveedorId    String?       @map("proveedor_id")
  /// Para los botones "Confirmo" / "No puedo" de una reprogramación.
  token          String?       @unique
  respuesta      String?
  respondidoEn   DateTime?     @map("respondido_en")
  error          String?
  enviadoEn      DateTime?     @map("enviado_en")
  entregadoEn    DateTime?     @map("entregado_en")
  leidoEn        DateTime?     @map("leido_en")
  creadoEn       DateTime      @default(now()) @map("creado_en")
  difusion       Difusion?     @relation(fields: [difusionId], references: [id], onDelete: Cascade)
  contingencia   Contingencia? @relation(fields: [contingenciaId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, clave])
  @@index([organizacionId, creadoEn])
  @@index([contingenciaId])
  @@map("mensaje")
}

/// Avisos automáticos que el organizador enciende o apaga.
model Automatizacion {
  id             String       @id @default(cuid())
  organizacionId String       @map("organizacion_id")
  clave          String
  activa         Boolean      @default(false)
  canal          CanalMensaje @default(WHATSAPP)

  @@unique([organizacionId, clave])
  @@map("automatizacion")
}

/// Una reprogramación aplicada (lluvia, cancha caída…): qué se movió y quién lo confirmó.
model Contingencia {
  id             String    @id @default(cuid())
  organizacionId String    @map("organizacion_id")
  motivo         String
  /// MOVER, SUSPENDER o CAMBIAR_CANCHA.
  accion         String
  /// Los movimientos: [{ partidoId, de: {...}, a: {...} }].
  detalle        Json
  aplicadaPorId  String?   @map("aplicada_por_id")
  creadoEn       DateTime  @default(now()) @map("creado_en")
  mensajes       Mensaje[]

  @@index([organizacionId, creadoEn])
  @@map("contingencia")
}

// ───────────── Árbitros y caja (por organización, con RLS) ─────────────

model Arbitro {
  id             String    @id @default(cuid())
  organizacionId String    @map("organizacion_id")
  nombre         String
  apellido       String
  telefono       String?
  email          String?
  /// Honorario por partido, en pesos.
  tarifa         Int       @default(0)
  /// Valoración de 1 a 5.
  valoracion     Float?
  activo         Boolean   @default(true)
  /// Franjas en las que puede dirigir: [{ dia: 0-6 (0 = domingo), desde: "HH:MM", hasta: "HH:MM" }]. Vacío = siempre.
  disponibilidad Json?
  creadoEn       DateTime  @default(now()) @map("creado_en")
  partidos       Partido[]

  @@map("arbitro")
}

/// Un movimiento de plata. Tiene líneas de debe y haber que suman lo mismo. No se edita ni se borra (lo impide la base):
/// una corrección es otro asiento que lo revierte.
model Asiento {
  id             String         @id @default(cuid())
  organizacionId String         @map("organizacion_id")
  fecha          DateTime       @default(now())
  descripcion    String
  /// COBRO, CARGO_SERVICIO, EGRESO, INGRESO, RETIRO o REVERSA.
  tipo           String
  torneoId       String?        @map("torneo_id")
  referenciaTipo String?        @map("referencia_tipo")
  referenciaId   String?        @map("referencia_id")
  arbitroId      String?        @map("arbitro_id")
  canchaId       String?        @map("cancha_id")
  comprobante    String?
  /// Hace idempotente un asiento automático (por ejemplo, "pago:<id>"): no se genera dos veces.
  clave          String?
  /// Si este asiento anula a otro, cuál. Un asiento se revierte una sola vez.
  revierteAId    String?        @unique @map("revierte_a_id")
  creadoPorId    String?        @map("creado_por_id")
  creadoEn       DateTime       @default(now()) @map("creado_en")
  lineas         LineaAsiento[]

  @@unique([organizacionId, clave])
  @@index([organizacionId, fecha])
  @@map("asiento")
}

model LineaAsiento {
  id             String  @id @default(cuid())
  organizacionId String  @map("organizacion_id")
  asientoId      String  @map("asiento_id")
  cuenta         String
  debe           Int     @default(0)
  haber          Int     @default(0)
  asiento        Asiento @relation(fields: [asientoId], references: [id], onDelete: Cascade)

  @@index([organizacionId, cuenta])
  @@index([asientoId])
  @@map("linea_asiento")
}

// ───────────── Documentación, identidad y consentimientos (E15) ─────────────

enum TipoDocumento {
  DNI
  APTO_FISICO
  AUTORIZACION_MENOR
}

enum EstadoRevision {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model DocumentoJugador {
  id             String            @id @default(cuid())
  organizacionId String            @map("organizacion_id")
  jugadorId      String            @map("jugador_id")
  tipo           TipoDocumento
  estado         EstadoRevision    @default(PENDIENTE)
  /// Clave en el almacenamiento privado. "demo:..." son documentos de muestra sin archivo real.
  archivoClave   String            @map("archivo_clave")
  archivoNombre  String            @map("archivo_nombre")
  mime           String
  tamano         Int
  vencimiento    DateTime?         @db.Date
  motivoRechazo  String?           @map("motivo_rechazo")
  revisadoPorId  String?           @map("revisado_por_id")
  revisadoEn     DateTime?         @map("revisado_en")
  creadoEn       DateTime          @default(now()) @map("creado_en")
  jugador        Jugador           @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  accesos        AccesoDocumento[]

  @@index([organizacionId, jugadorId])
  @@map("documento_jugador")
}

/// Quién pidió ver un documento y cuándo. Se borra por retención.
model AccesoDocumento {
  id             String           @id @default(cuid())
  organizacionId String           @map("organizacion_id")
  documentoId    String           @map("documento_id")
  usuarioId      String?          @map("usuario_id")
  accion         String
  creadoEn       DateTime         @default(now()) @map("creado_en")
  documento      DocumentoJugador @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([organizacionId, documentoId])
  @@map("acceso_documento")
}

enum EstadoDuplicado {
  ABIERTO
  RESUELTO
}

/// Dos jugadores de la organización con el mismo DNI.
model DuplicadoJugador {
  id             String          @id @default(cuid())
  organizacionId String          @map("organizacion_id")
  jugadorAId     String          @map("jugador_a_id")
  jugadorBId     String          @map("jugador_b_id")
  estado         EstadoDuplicado @default(ABIERTO)
  resolucion     String?
  resueltoPorId  String?         @map("resuelto_por_id")
  creadoEn       DateTime        @default(now()) @map("creado_en")
  resueltoEn     DateTime?       @map("resuelto_en")

  @@unique([jugadorAId, jugadorBId])
  @@index([organizacionId, estado])
  @@map("duplicado_jugador")
}

/// Consentimiento versionado: del tutor (menores) o del propio jugador. Se revoca, no se borra.
model Consentimiento {
  id             String    @id @default(cuid())
  organizacionId String    @map("organizacion_id")
  jugadorId      String    @map("jugador_id")
  tipo           String
  version        Int
  otorgante      String
  otorganteDni   String?   @map("otorgante_dni")
  vinculo        String?
  otorgadoEn     DateTime  @default(now()) @map("otorgado_en")
  revocadoEn     DateTime? @map("revocado_en")
  jugador        Jugador   @relation(fields: [jugadorId], references: [id], onDelete: Cascade)

  @@index([organizacionId, jugadorId])
  @@map("consentimiento")
}

/// Link que se le manda al tutor para que autorice en línea. El token es la credencial.
model SolicitudConsentimiento {
  id             String    @id @default(cuid())
  organizacionId String    @map("organizacion_id")
  jugadorId      String    @map("jugador_id")
  token          String    @unique
  venceEn        DateTime  @map("vence_en")
  usadaEn        DateTime? @map("usada_en")
  creadoEn       DateTime  @default(now()) @map("creado_en")

  @@index([organizacionId, jugadorId])
  @@map("solicitud_consentimiento")
}

// ───────────── Sponsors (E23) ─────────────

/// Auspiciante de la organización. Lo vende el organizador (documento 2, sección 6).
model Sponsor {
  id             String      @id @default(cuid())
  organizacionId String      @map("organizacion_id")
  nombre         String
  /// CATEGORIAS_SPONSOR de @potrero/shared.
  categoria      String
  descripcion    String?
  link           String?
  logoUrl        String?     @map("logo_url")
  creadoEn       DateTime    @default(now()) @map("creado_en")
  placements     Placement[]

  @@unique([organizacionId, nombre])
  @@map("sponsor")
}

/// Espacio vendido a un sponsor en el sitio de un torneo, por un período y un monto acordado.
/// Sus cobros son asientos INGRESO de la caja con referenciaTipo "SPONSOR" y referenciaId = sponsor.
model Placement {
  id             String             @id @default(cuid())
  organizacionId String             @map("organizacion_id")
  sponsorId      String             @map("sponsor_id")
  torneoId       String             @map("torneo_id")
  /// ESPACIOS_SPONSOR de @potrero/shared.
  espacio        String
  desde          DateTime           @db.Date
  hasta          DateTime           @db.Date
  /// Monto acordado por todo el período, en pesos.
  monto          Int
  activo         Boolean            @default(true)
  creadoEn       DateTime           @default(now()) @map("creado_en")
  sponsor        Sponsor            @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  metricas       MetricaPlacement[]

  @@index([organizacionId, torneoId])
  @@map("placement")
}

/// Impresiones y clics de un espacio por día. Solo contadores: ni cookies ni datos del visitante.
model MetricaPlacement {
  id             String    @id @default(cuid())
  organizacionId String    @map("organizacion_id")
  placementId    String    @map("placement_id")
  dia            DateTime  @db.Date
  impresiones    Int       @default(0)
  clics          Int       @default(0)
  placement      Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([placementId, dia])
  @@map("metrica_placement")
}

/// Rubros que la organización no acepta como sponsors, además de los prohibidos con menores.
model PreferenciasSponsors {
  organizacionId       String   @id @map("organizacion_id")
  categoriasRechazadas String[] @default([]) @map("categorias_rechazadas")

  @@map("preferencias_sponsors")
}

// ───────────── Usuarios de la organización y panel del capitán (E04-09, E19) ─────────────

/// Invitación a sumarse a la organización con un rol. El link lleva un token de un solo uso (se guarda solo su hash).
model Invitacion {
  id             String    @id @default(cuid())
  organizacionId String    @map("organizacion_id")
  email          String
  nombre         String?
  rol            Rol
  /// Solo para CAPITAN: el equipo que va a manejar.
  equipoId       String?   @map("equipo_id")
  /// Solo para JUGADOR (E20-01): el perfil que reclama (lo invita el capitán desde su plantel).
  jugadorId      String?   @map("jugador_id")
  tokenHash      String    @unique @map("token_hash")
  venceEn        DateTime  @map("vence_en")
  aceptadaEn     DateTime? @map("aceptada_en")
  rechazadaEn    DateTime? @map("rechazada_en")
  anuladaEn      DateTime? @map("anulada_en")
  invitadoPorId  String?   @map("invitado_por_id")
  creadoEn       DateTime  @default(now()) @map("creado_en")

  @@index([organizacionId, email])
  @@map("invitacion")
}

/// Convocatoria a un partido (E19-02): la respuesta de cada jugador del plantel, que carga el capitán. Sin fila = pendiente.
model Convocatoria {
  id             String   @id @default(cuid())
  organizacionId String   @map("organizacion_id")
  partidoId      String   @map("partido_id")
  equipoId       String   @map("equipo_id")
  jugadorId      String   @map("jugador_id")
  /// VA o NO_VA.
  respuesta      String
  respondidoEn   DateTime @default(now()) @map("respondido_en")

  @@unique([partidoId, jugadorId])
  @@index([organizacionId, partidoId])
  @@map("convocatoria")
}

// ───────────── Backoffice de Gregal (E36) ─────────────
// Equipo interno de Gregal Tech: tablas globales, separadas de usuarios y membresías de las organizaciones.
// Solo las usa el módulo `gregal` con `db.sistema` (lee todas las ligas); cada acción del staff queda en StaffAuditoria.

enum RolStaff {
  SUPERADMIN
  SOPORTE
  FINANZAS
  DIRECCION
}

model StaffUsuario {
  id              String           @id @default(cuid())
  email           String           @unique
  nombre          String
  passwordHash    String           @map("password_hash")
  rol             RolStaff
  activo          Boolean          @default(true)
  ultimoIngresoEn DateTime?        @map("ultimo_ingreso_en")
  creadoEn        DateTime         @default(now()) @map("creado_en")
  acciones        StaffAuditoria[]

  @@map("staff_usuario")
}

/// Registro inmutable de cada acción del staff (E36-03): ingresos, lecturas de ligas y cambios. La base rechaza editarlo.
model StaffAuditoria {
  id             String        @id @default(cuid())
  staffId        String?       @map("staff_id")
  accion         String
  entidad        String?
  entidadId      String?       @map("entidad_id")
  organizacionId String?       @map("organizacion_id")
  detalle        Json?
  ip             String?
  creadoEn       DateTime      @default(now()) @map("creado_en")
  staff          StaffUsuario? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([creadoEn])
  @@index([staffId, creadoEn])
  @@map("staff_auditoria")
}

/// Fase de un torneo por fases (ADR-026, E10-07). Guarda la definición validada (FaseDeFormato de @potrero/shared)
/// y, una vez generada, sus equipos, grupos o cuadro y la programación. Los partidos apuntan con `Partido.faseId`.
model Fase {
  id             String     @id @default(cuid())
  organizacionId String     @map("organizacion_id")
  torneoId       String     @map("torneo_id")
  /// Identificador dentro del formato ("f1", "f2"…), el que usan las entradas de las otras fases.
  clave          String
  orden          Int
  nombre         String
  tipo           String
  /// FaseDeFormato completa: entradas, ruedas, grupos, ida y vuelta por ronda, cruces.
  definicion     Json
  estado         EstadoFase @default(PENDIENTE)
  /// Equipos que entraron, de mejor a peor semilla.
  equipoIds      String[]   @default([]) @map("equipo_ids")
  /// Grupos: [{ grupo, equipoIds }] (un todos contra todos tiene uno solo, con grupo null).
  grupos         Json?
  /// Eliminación: { cuadro, programacion }.
  llave          Json?
  /// Número de fecha del torneo desde el que se cuentan las fechas de esta fase.
  baseFecha      Int        @default(0) @map("base_fecha")
  creadoEn       DateTime   @default(now()) @map("creado_en")
  torneo         Torneo     @relation(fields: [torneoId], references: [id], onDelete: Cascade)

  @@unique([torneoId, clave])
  @@map("fase")
}

enum EstadoFase {
  PENDIENTE
  EN_CURSO
  FINALIZADA
}
