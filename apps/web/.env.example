# URL de la API (el servidor de Next la usa para el renderizado y para reenviar /api/*).
API_URL=http://localhost:4000
# Entorno de demo pública (ADR-019): "true" muestra el banner de demo y pide a los buscadores que no indexen. Se fija al compilar.
NEXT_PUBLIC_DEMO_MODE=false
# Direcciones de los dos entornos (ADR-019). La landing de producción manda a la demo por NEXT_PUBLIC_DEMO_URL;
# la demo manda a crear una liga real por NEXT_PUBLIC_APP_URL. Vacías = mismo origen (desarrollo local).
NEXT_PUBLIC_DEMO_URL=
NEXT_PUBLIC_APP_URL=
# Clave pública de Cloudflare Turnstile (la secreta va en la API como TURNSTILE_SECRET). Sin clave, sin captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
